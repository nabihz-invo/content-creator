{
  "name": "content-creator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test \"n8n/scripts/*.test.mjs\"",
    "build": "pnpm -r --if-present build",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:reset": "bash scripts/db.sh reset",
    "db:test": "bash scripts/db.sh test",
    "sync:edge": "pnpm --filter @cc/shared sync:edge",
    "stack:up": "bash scripts/local-stack/stack.sh up",
    "stack:down": "bash scripts/local-stack/stack.sh down",
    "e2e": "node scripts/e2e/crm-smoke.mjs",
    "dev:crm": "pnpm --filter @cc/crm dev",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supabase": "^2.122.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
