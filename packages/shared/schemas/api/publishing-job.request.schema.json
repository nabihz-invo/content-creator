{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc.local/schemas/api/publishing-job.request.schema.json",
  "title": "POST /api/publishing-jobs",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "approval_id", "platform", "caption"],
  "properties": {
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "approval_id": {
      "type": "string",
      "format": "uuid"
    },
    "platform": {
      "enum": ["instagram", "facebook", "linkedin", "x", "tiktok", "threads", "youtube"]
    },
    "caption": {
      "type": "string",
      "maxLength": 70000
    },
    "hashtags": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "link": {
      "type": ["string", "null"],
      "maxLength": 2000
    }
  }
}
