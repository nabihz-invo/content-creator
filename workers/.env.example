# Environment for the long-running workers (docs/DEPLOYMENT.md).
# Copy to workers/.env on the server (git-ignored) and fill in. Never commit real values.

# --- shared by creative worker, render worker, preview server -------------
# Supabase → Project Settings → Database → connection string (port 5432)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- creatives repository (creative worker: read/write, render worker: read) ---
# Fine-grained GitHub token, this repository only, Contents: Read and write.
CREATIVES_REPO_URL=https://x-access-token:<TOKEN>@github.com/<owner>/<repo>.git
# Shown in the CRM and stored on each version — never contains the token.
CREATIVES_REPO_DISPLAY_URL=https://github.com/<owner>/<repo>

# --- creative worker -------------------------------------------------------
# "template" (no AI, good first test) or "claude-code" (needs the claude CLI + key)
CREATIVE_GENERATOR=template
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_BUDGET_USD=5

# --- render worker ---------------------------------------------------------
RENDER_OUTPUT_TYPES=png,carousel
RENDER_CONCURRENCY=1

# --- preview server (must be served on its own https origin) --------------
PORT=54400
PREVIEW_SIGNING_SECRET=
# The CRM origin(s) allowed to frame previews, comma-separated
CRM_ALLOWED_ORIGINS=

# --- optional: Telegram notifications through n8n -------------------------
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Playwright (thumbnails, renders) is resolved from here: output of `npm root -g`
NODE_PATH=
