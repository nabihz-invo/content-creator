{
  "imports": {
    "hono": "npm:hono@4.13.14",
    "hono/": "npm:/hono@4.13.14/",
    "postgres": "npm:postgres@3.4.9",
    "ajv": "npm:ajv@8.20.0",
    "ajv/": "npm:/ajv@8.20.0/",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.3.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "jsr:@std/csv@1",
    "@std/encoding": "jsr:@std/encoding@1"
  },
  "tasks": {
    "check": "deno check --quiet api/index.ts telegram-webhook/index.ts && deno lint",
    "test": "deno test --allow-net --allow-env --allow-read tests/"
