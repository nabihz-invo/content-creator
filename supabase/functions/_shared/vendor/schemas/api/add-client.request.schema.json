{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc.local/schemas/api/add-client.request.schema.json",
  "title": "POST /api/workspaces/{id}/clients",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "brand_ids"],
  "properties": {
    "email": { "type": "string", "format": "email", "maxLength": 320 },
    "brand_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" },
      "description": "The brands whose approved posts the client reviews"
    }
  }
}
