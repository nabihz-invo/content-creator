{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc.local/schemas/api/imported-review.request.schema.json",
  "title": "POST /api/content-projects/{id}/imported-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision"],
  "properties": {
    "decision": { "enum": ["approved", "changes_requested"] },
    "note": {
      "type": "string",
      "maxLength": 4000,
      "description": "What should change (required for changes_requested)"
    }
  }
}
