# Edge Function secrets (set with `supabase secrets set --env-file ...`).
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL
# are injected automatically on hosted Supabase.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRM_URL=
CRM_ALLOWED_ORIGINS=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# AI stages: "anthropic" (default) needs ANTHROPIC_API_KEY; "fake" for tests.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Isolated preview origin (workers/preview-server); same secret as the preview server.
PREVIEW_ORIGIN=
PREVIEW_SIGNING_SECRET=
