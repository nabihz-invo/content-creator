node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# secrets
.env
.env.*
!.env.example

# supabase local
supabase/.branches
supabase/.temp

# media / render output
*.mp4
*.mov
renders/
tmp/
tmp/

# Local mirror of the brand asset library (BRAND_ASSETS_DIR; scripts/brand/sync-kit.mjs pull)
.brand-assets/
# Local creatives repository (CREATIVES_REPO_URL, ADR-0002) until it moves to GitHub
.creatives.git/

# Skill packages as delivered (the unpacked copy lives in templates/studio/docs/motion/)
skills/*.zip

# Machine-specific Claude Code settings (can hold commands with secrets)
.claude/settings.local.json

# content/: tools, assets, plans and post sources are tracked. Rendered output stays on the PC that
# made it (finished posts are in the CRM), so it never fills the repo.
content/studio/examples/**/*.png
content/assets/**/*.rar
content/posts/**/en/
content/posts/**/ar/
content/posts/**/ar-needs-native-review/
content/posts/**/png-en/
content/posts/**/png-ar/
content/posts/**/html/
content/posts/**/preview/
content/posts/**/final/
content/posts/**/*.png
content/posts/**/*.pdf
!content/posts/**/img/
!content/posts/**/img/*.png
# Reel footage is source material, unlike rendered .mp4 files
!content/assets/clips/**/*.mp4
